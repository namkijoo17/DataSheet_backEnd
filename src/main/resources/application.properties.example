spring.application.name=DataSheet

spring.datasource.url=jdbc:sqlserver://localhost:1433;databaseName=datasheet;encrypt=true;trustServerCertificate=true
spring.datasource.username=YOUR_DB_USERNAME
spring.datasource.password=YOUR_DB_PASSWORD

spring.jpa.hibernate.ddl-auto=none
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.SQLServerDialect
spring.jpa.open-in-view=false

# JWT Access Token (30분) — 만료 시 /api/auth/refresh 로 재발급
app.jwt.secret=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
app.jwt.expiration-ms=1800000
# Refresh Token (12시간)
app.jwt.refresh-expiration-ms=43200000

# 로그인 실패 5회 시 계정 잠금
app.auth.max-failed-login=5

# 데이터시트 파일 폴더 (수동으로 PDF 등 배치)
app.file.datasheet-dir=./storage/datasheets
# 검사 완료 결과 PDF 폴더 (파일 보관함)
app.file.inspection-dir=./storage/inspections

# 업로드 용량 (결과 PDF 는 페이지 이미지 포함)
spring.servlet.multipart.max-file-size=50MB
spring.servlet.multipart.max-request-size=50MB

# Swagger
springdoc.swagger-ui.path=/swagger-ui.html
springdoc.api-docs.path=/v3/api-docs

